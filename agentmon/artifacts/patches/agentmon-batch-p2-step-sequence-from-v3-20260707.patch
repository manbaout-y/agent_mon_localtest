+def proc_sample(
+    *,
+    pid: int,
+    role: str,
+    starttime: int,
+    utime: int,
+    stime: int,
+    rss: int,
+    pss: int,
+    pgid: int | None = None,
+) -> dict:
+    return {
+        "pid": pid,
+        "role": role,
+        "starttime_ticks": starttime,
+        "pgid": pgid if pgid is not None else pid,
+        "utime_ticks": utime,
+        "stime_ticks": stime,
+        "rss_bytes": rss,
+        "pss_bytes": pss,
+        "read_bytes": 0,
+        "write_bytes": 0,
