index 0000000..0744540
--- /dev/null
+++ b/scripts/agentmon_step_sequence.py
@@ -0,0 +1,1302 @@
+#!/usr/bin/env python3
+from __future__ import annotations
+
+import argparse
+import csv
+import io
+import json
+from pathlib import Path
+import sys
+from typing import Any, Sequence
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SRC = ROOT / "src"
+if str(SRC) not in sys.path:
+    sys.path.insert(0, str(SRC))
+
+
+SCHEMA_VERSION = "1.0"
+SPAN_TYPES = {"run", "agent_step", "model_request", "tool_call"}
+REQUEST_TIME_KEYS = (
+    "received_ns",
+    "queued_ns",
+    "first_scheduled_ns",
+    "prefill_completed_ns",
+    "first_token_ns",
+    "finished_ns",
+)
+P2_VALUE_KEYS = (
+    "agent_request_id",
+    "vllm_request_id",
+    "api_request_id",
+    "request_id",
+    "run_id",
+    "model_name",
+    "correlation_quality",
+    "finish_reason",
+    "prompt_tokens",
+    "cached_prompt_tokens",
+    "computed_prefill_tokens",
+    "recomputed_prompt_tokens",
+    "generation_tokens",
+    "preemption_count",
+    "allocated_block_count",
+    "freed_block_count",
+    "evicted_block_count",
+    "kv_usage_before",
+    "kv_usage_after",
+    "kv_quality",
+)
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    args = build_parser().parse_args(argv)
+    try:
+        analyses = [
+            build_step_sequence(
+                Path(run_dir),
+                p2_events=Path(args.p2_events) if args.p2_events else None,
+                ascend_devices=args.ascend_devices,
+            )
+            for run_dir in args.run_dirs
+        ]
+        payload: dict[str, Any] | list[dict[str, Any]]
+        payload = analyses[0] if len(analyses) == 1 else analyses
+        print(format_output(payload, args.format))
+    except Exception as exc:
+        print(f"agentmon step sequence error: {exc}", file=sys.stderr)
+        return 2
+    return 0
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        description="Analyze AgentMon P1/P2 events as a per-agent-step execution sequence",
+    )
+    parser.add_argument("run_dirs", nargs="+", help="AgentMon run directory/directories containing events.jsonl")
+    parser.add_argument(
+        "--p2-events",
+        help="optional service-scoped P2 events.jsonl to correlate with one run",
+    )
+    parser.add_argument(
+        "--ascend-devices",
+        help="comma-separated npu-smi device ids for target/model attribution; defaults to P2 visible_devices when available",
+    )
+    parser.add_argument("--format", choices=["table", "json", "csv"], default="table")
+    return parser
+
+
+def build_step_sequence(
+    run_dir: Path,
+    *,
+    p2_events: Path | None = None,
+    ascend_devices: str | None = None,
+) -> dict[str, Any]:
+    run_event_log = read_jsonl(run_dir / "events.jsonl")
+    events = run_event_log["events"]
+    p2_event_log = read_jsonl(p2_events) if p2_events is not None else {"events": [], "invalid_lines": 0}
+    all_p2_events = [event for event in events if event.get("source") == "vllm_p2"] + list(p2_event_log["events"])
+    p2_index = build_p2_index(all_p2_events)
+    spans = build_spans(events)
+    resources = build_resource_context(events, all_p2_events, ascend_devices=ascend_devices)
+    analysis = assemble_sequence(run_dir, events, spans, p2_index, resources)
+    analysis["invalid_json_lines"] = run_event_log["invalid_lines"]
+    analysis["external_p2_invalid_json_lines"] = p2_event_log["invalid_lines"]
+    analysis["p2"] = {
+        "source": "run_events" if p2_events is None else "run_events+external",
+        "request_count": len(p2_index["rows"]),
+        "direct_agent_request_count": sum(1 for row in p2_index["rows"] if row.get("agent_request_id")),
+    }
+    return analysis
+
+
+def read_jsonl(path: Path) -> dict[str, Any]:
+    events: list[dict[str, Any]] = []
+    invalid_lines = 0
+    if not path.exists():
+        return {"events": events, "invalid_lines": 0}
+    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
+        if not line.strip():
+            continue
+        try:
+            item = json.loads(line)
+        except json.JSONDecodeError:
+            invalid_lines += 1
+            continue
+        if isinstance(item, dict):
+            events.append(item)
+    return {"events": events, "invalid_lines": invalid_lines}
+
+
+def build_spans(events: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    starts: dict[str, dict[str, Any]] = {}
+    ends: list[dict[str, Any]] = []
+    for event in events:
+        lifecycle = span_lifecycle(event)
+        if lifecycle is None:
+            continue
+        payload = as_dict(event.get("payload"))
+        span_id = span_identifier(payload)
+        if span_id is None:
+            continue
+        if lifecycle == "start":
+            starts[span_id] = event
+        else:
+            ends.append(event)
+
+    spans: list[dict[str, Any]] = []
+    ended: set[str] = set()
+    for end_event in ends:
+        end_payload = as_dict(end_event.get("payload"))
+        span_id = span_identifier(end_payload)
+        if span_id is None:
+            continue
+        ended.add(span_id)
+        spans.append(merge_span(span_id, starts.get(span_id), end_event))
+
+    for span_id, start_event in starts.items():
+        if span_id not in ended:
+            spans.append(merge_span(span_id, start_event, None))
+
+    spans.sort(key=lambda span: sort_time(span))
+    return spans
+
+
+def span_lifecycle(event: dict[str, Any]) -> str | None:
+    payload = as_dict(event.get("payload"))
+    span_type = payload.get("span_type")
+    if span_type not in SPAN_TYPES:
+        return None
+    event_type = str(event.get("event_type") or "")
+    if event_type == "span_start" or event_type.endswith(".start"):
+        return "start"
+    if event_type == "span_end" or event_type.endswith(".end") or event_type.endswith(".error"):
+        return "finish"
+    return None
+
+
+def span_identifier(payload: dict[str, Any]) -> str | None:
+    value = payload.get("span_id") or payload.get("tool_call_id") or payload.get("request_id")
+    return str(value) if value not in {None, ""} else None
+
+
+def merge_span(span_id: str, start_event: dict[str, Any] | None, end_event: dict[str, Any] | None) -> dict[str, Any]:
+    start_payload = as_dict(start_event.get("payload")) if start_event else {}
+    end_payload = as_dict(end_event.get("payload")) if end_event else {}
+    attributes = as_dict(start_payload.get("attributes"))
+    span_type = end_payload.get("span_type") or start_payload.get("span_type")
+    start_mono_ns = first_int(
+        start_payload.get("start_mono_ns"),
+        start_event.get("monotonic_time_ns") if start_event else None,
+        end_payload.get("start_mono_ns"),
+    )
+    end_mono_ns = first_int(
+        end_payload.get("end_mono_ns"),
+        end_event.get("monotonic_time_ns") if end_event else None,
+    )
+    duration_ns = first_int(end_payload.get("duration_ns"), ns_delta(start_mono_ns, end_mono_ns))
+    return {
+        "span_id": span_id,
+        "span_type": span_type,
+        "step_id": first_value(end_payload.get("step_id"), start_payload.get("step_id"), attributes.get("step_id")),
+        "parent_span_id": first_value(end_payload.get("parent_span_id"), start_payload.get("parent_span_id")),
+        "status": first_value(end_payload.get("status"), "open" if end_event is None else None),
+        "start_mono_ns": start_mono_ns,
+        "end_mono_ns": end_mono_ns,
+        "duration_ns": duration_ns,
+        "duration_s": ns_to_s(duration_ns),
+        "start_event_type": start_event.get("event_type") if start_event else None,
+        "end_event_type": end_event.get("event_type") if end_event else None,
+        "start_payload": start_payload,
+        "end_payload": end_payload,
+        "attributes": attributes,
+    }
+
+
+def assemble_sequence(
+    run_dir: Path,
+    events: list[dict[str, Any]],
+    spans: list[dict[str, Any]],
+    p2_index: dict[str, Any],
+    resources: dict[str, Any],
+) -> dict[str, Any]:
+    run_id = run_id_from_events(events) or run_dir.name
+    step_spans = [span for span in spans if span.get("span_type") == "agent_step"]
+    child_spans = [span for span in spans if span.get("span_type") in {"model_request", "tool_call"}]
+    steps_by_id = {str(span["span_id"]): make_step(span) for span in step_spans}
+
+    for child in child_spans:
+        step_id = step_id_for_child(child)
+        if step_id is None:
+            continue
+        steps_by_id.setdefault(step_id, synthetic_step(step_id))
+
+    for child in child_spans:
+        step_id = step_id_for_child(child)
+        if step_id is None or step_id not in steps_by_id:
+            continue
+        item = make_item(child, p2_index, resources)
+        steps_by_id[step_id]["items"].append(item)
+
+    steps = list(steps_by_id.values())
+    for step in steps:
+        finalize_step(step, resources)
+    steps.sort(key=lambda step: sort_time(step))
+    for index, step in enumerate(steps, start=1):
+        step["step_index"] = index
+
+    unassigned = [make_item(span, p2_index, resources) for span in child_spans if step_id_for_child(span) is None]
+    totals = build_totals(steps, unassigned)
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "analysis_type": "agentmon.step_sequence",
+        "run_id": run_id,
+        "run_dir": str(run_dir),
+        "event_count": len(events),
+        "totals": totals,
+        "steps": steps,
+        "unassigned_items": unassigned,
+        "resource_attribution": {
+            "proc_sample_count": len(resources["proc_events"]),
+            "ascend_sample_count": len(resources["ascend_events"]),
+            "ascend_target_devices": sorted(resources["ascend_target_devices"])
+            if resources["ascend_target_devices"]
+            else None,
+            "ascend_target_device_source": resources["ascend_target_device_source"],
+        },
+        "warnings": build_warnings(steps, unassigned),
+    }
+
+
+def make_step(span: dict[str, Any]) -> dict[str, Any]:
+    return {
+        "step_index": None,
+        "step_id": span.get("span_id"),
+        "status": span.get("status"),
+        "start_mono_ns": span.get("start_mono_ns"),
+        "end_mono_ns": span.get("end_mono_ns"),
+        "duration_s": span.get("duration_s"),
+        "model_time_s": 0.0,
+        "tool_time_s": 0.0,
+        "unaccounted_time_s": None,
+        "model_request_count": 0,
+        "tool_call_count": 0,
+        "items": [],
+    }
+
+
+def synthetic_step(step_id: str) -> dict[str, Any]:
+    return {
+        "step_index": None,
+        "step_id": step_id,
+        "status": "synthetic",
+        "start_mono_ns": None,
+        "end_mono_ns": None,
+        "duration_s": None,
+        "model_time_s": 0.0,
+        "tool_time_s": 0.0,
+        "unaccounted_time_s": None,
+        "model_request_count": 0,
+        "tool_call_count": 0,
+        "items": [],
+    }
+
+
+def finalize_step(step: dict[str, Any], resources: dict[str, Any]) -> None:
+    items = step["items"]
+    items.sort(key=lambda item: sort_time(item))
+    if step.get("start_mono_ns") is None and items:
+        step["start_mono_ns"] = min_int(item.get("start_mono_ns") for item in items)
+    if step.get("end_mono_ns") is None and items:
+        step["end_mono_ns"] = max_int(item.get("end_mono_ns") for item in items)
+    if step.get("duration_s") is None:
+        step["duration_s"] = ns_to_s(ns_delta(step.get("start_mono_ns"), step.get("end_mono_ns")))
+
+    for index, item in enumerate(items, start=1):
+        item["item_index"] = index
+        item["start_offset_s"] = ns_to_s(ns_delta(step.get("start_mono_ns"), item.get("start_mono_ns")))
+
+    model_time = sum(item.get("duration_s") or 0 for item in items if item.get("item_type") == "model")
+    tool_time = sum(item.get("duration_s") or 0 for item in items if item.get("item_type") == "tool")
+    step["model_time_s"] = model_time
+    step["tool_time_s"] = tool_time
+    step["model_request_count"] = sum(1 for item in items if item.get("item_type") == "model")
+    step["tool_call_count"] = sum(1 for item in items if item.get("item_type") == "tool")
+    step.update(step_kv_summary(items))
+    step["agent_proc"] = proc_window_summary(
+        resources["proc_events"],
+        step.get("start_mono_ns"),
+        step.get("end_mono_ns"),
+        role="agent",
+    )
+    step["vllm_proc"] = proc_window_summary(
+        resources["proc_events"],
+        step.get("start_mono_ns"),
+        step.get("end_mono_ns"),
+        role="vllm",
+    )
+    step["npu"] = ascend_window_summary(
+        resources["ascend_events"],
+        step.get("start_mono_ns"),
+        step.get("end_mono_ns"),
+        target_devices=resources["ascend_target_devices"],
+    )
+    duration = step.get("duration_s")
+    step["unaccounted_time_s"] = duration - model_time - tool_time if isinstance(duration, (int, float)) else None
+
+
+def make_item(span: dict[str, Any], p2_index: dict[str, Any], resources: dict[str, Any]) -> dict[str, Any]:
+    if span.get("span_type") == "model_request":
+        return make_model_item(span, p2_index, resources)
+    return make_tool_item(span, resources)
+
+
+def make_model_item(span: dict[str, Any], p2_index: dict[str, Any], resources: dict[str, Any]) -> dict[str, Any]:
+    start_payload = span["start_payload"]
+    end_payload = span["end_payload"]
+    attributes = span["attributes"]
+    usage = as_dict(end_payload.get("usage"))
+    p2_row = find_p2_row(span, p2_index)
+    p2_snapshot = nearest_kv_snapshot(
+        p2_index["snapshots"],
+        first_int(p2_row.get("finished_ns"), span.get("end_mono_ns"), span.get("start_mono_ns")),
+    )
+    window_start_ns = first_int(p2_row.get("received_ns"), span.get("start_mono_ns"))
+    window_end_ns = first_int(p2_row.get("finished_ns"), span.get("end_mono_ns"))
+    return {
+        **base_item(span, "model"),
+        "model_name": first_value(start_payload.get("model_name"), attributes.get("model_name"), p2_row.get("model_name")),
+        "headers_injected": first_value(start_payload.get("headers_injected"), attributes.get("headers_injected")),
+        "message_count": first_value(start_payload.get("message_count"), attributes.get("message_count")),
+        "input_chars": first_value(start_payload.get("input_chars"), attributes.get("input_chars")),
+        "prompt_tokens": integer_or_none(usage.get("prompt_tokens")),
+        "completion_tokens": integer_or_none(usage.get("completion_tokens")),
+        "cached_tokens": cached_tokens_from_usage(usage),
+        "cost": number_or_none(usage.get("cost")),
+        "p2": p2_projection(p2_row, p2_snapshot),
+        "vllm_proc": proc_window_summary(resources["proc_events"], window_start_ns, window_end_ns, role="vllm"),
+        "npu": ascend_window_summary(
+            resources["ascend_events"],
+            window_start_ns,
+            window_end_ns,
+            target_devices=resources["ascend_target_devices"],
+        ),
+    }
+
+
+def make_tool_item(span: dict[str, Any], resources: dict[str, Any]) -> dict[str, Any]:
+    start_payload = span["start_payload"]
+    end_payload = span["end_payload"]
+    attributes = span["attributes"]
+    pid = integer_or_none(end_payload.get("pid"))
+    pgid = integer_or_none(end_payload.get("pgid"))
+    return {
+        **base_item(span, "tool"),
+        "tool_name": first_value(end_payload.get("tool_name"), start_payload.get("tool_name"), attributes.get("tool_name")),
+        "executable": first_value(end_payload.get("executable"), start_payload.get("executable"), attributes.get("executable")),
+        "action_type": first_value(end_payload.get("action_type"), start_payload.get("action_type"), attributes.get("action_type")),
+        "command_hash": first_value(end_payload.get("command_hash"), start_payload.get("command_hash"), attributes.get("command_hash")),
+        "command_argc": first_value(end_payload.get("command_argc"), start_payload.get("command_argc"), attributes.get("command_argc")),
+        "cwd": first_value(end_payload.get("cwd"), start_payload.get("cwd"), attributes.get("cwd")),
+        "returncode": integer_or_none(end_payload.get("returncode")),
+        "timed_out": end_payload.get("timed_out"),
+        "pid": pid,
+        "pgid": pgid,
+        "stdout_bytes": integer_or_none(end_payload.get("stdout_bytes")),
+        "stderr_bytes": integer_or_none(end_payload.get("stderr_bytes")),
+        "output_bytes": integer_or_none(end_payload.get("output_bytes")),
+        "attribution_quality": end_payload.get("attribution_quality"),
+        "proc": proc_window_summary(
+            resources["proc_events"],
+            span.get("start_mono_ns"),
+            span.get("end_mono_ns"),
+            pid=pid,
+            pgid=pgid,
+        ),
+    }
+
+
+def base_item(span: dict[str, Any], item_type: str) -> dict[str, Any]:
+    return {
+        "item_index": None,
+        "item_type": item_type,
+        "span_id": span.get("span_id"),
+        "step_id": step_id_for_child(span),
+        "status": span.get("status"),
+        "start_mono_ns": span.get("start_mono_ns"),
+        "end_mono_ns": span.get("end_mono_ns"),
+        "duration_s": span.get("duration_s"),
+        "start_offset_s": None,
+        "end_event_type": span.get("end_event_type"),
+    }
+
+
+def step_id_for_child(span: dict[str, Any]) -> str | None:
+    for value in (span.get("step_id"), span.get("parent_span_id")):
+        if value not in {None, ""}:
+            return str(value)
+    return None
+
+
+def build_p2_index(events: list[dict[str, Any]]) -> dict[str, Any]:
+    rows_by_key: dict[str, dict[str, Any]] = {}
+    snapshots: list[dict[str, Any]] = []
+    for event in events:
+        if event.get("source") != "vllm_p2":
+            continue
+        event_type = str(event.get("event_type") or "")
+        payload = as_dict(event.get("payload"))
+        if event_type == "vllm.kv.snapshot":
+            snapshots.append(kv_snapshot_row(payload, event))
+            continue
+        if not event_type.startswith("vllm.request.") and event_type != "vllm.kv.block_event":
+            continue
+        key = p2_row_key(payload)
+        if key is None:
+            continue
+        row = rows_by_key.setdefault(key, {})
+        merge_p2_payload(row, payload, event_type=event_type, event=event)
+
+    rows = list(rows_by_key.values())
+    by_id: dict[str, dict[str, Any]] = {}
+    for row in rows:
+        for key in ("agent_request_id", "vllm_request_id", "api_request_id", "request_id"):
+            value = row.get(key)
+            if value not in {None, ""}:
+                by_id[str(value)] = row
+    snapshots.sort(key=lambda row: row.get("monotonic_time_ns") if isinstance(row.get("monotonic_time_ns"), int) else -1)
+    return {"rows": rows, "by_id": by_id, "snapshots": snapshots}
+
+
+def p2_row_key(payload: dict[str, Any]) -> str | None:
+    for key in ("vllm_request_id", "request_id", "agent_request_id", "api_request_id"):
+        value = payload.get(key)
+        if value not in {None, ""}:
+            return f"{key}:{value}"
+    return None
+
+
+def merge_p2_payload(row: dict[str, Any], payload: dict[str, Any], *, event_type: str, event: dict[str, Any]) -> None:
+    for key in P2_VALUE_KEYS:
+        value = payload.get(key)
+        if value is not None:
+            target = "vllm_request_id" if key == "request_id" else key
+            row[target] = value
+    for key in REQUEST_TIME_KEYS:
+        value = integer_or_none(payload.get(key))
+        if value is not None:
+            row[key] = value
+    fallback_time = integer_or_none(event.get("monotonic_time_ns"))
+    event_time_key = {
+        "vllm.request.received": "received_ns",
+        "vllm.request.queued": "queued_ns",
+        "vllm.request.first_scheduled": "first_scheduled_ns",
+        "vllm.request.prefill_completed": "prefill_completed_ns",
+        "vllm.request.first_token": "first_token_ns",
+        "vllm.request.finished": "finished_ns",
+    }.get(event_type)
+    if event_time_key and row.get(event_time_key) is None and fallback_time is not None:
+        row[event_time_key] = fallback_time
+    row["last_event_type"] = event_type
+
+
+def find_p2_row(span: dict[str, Any], p2_index: dict[str, Any]) -> dict[str, Any]:
+    start_payload = span["start_payload"]
+    attributes = span["attributes"]
+    candidates = [
+        span.get("span_id"),
+        start_payload.get("agentmon_model_request_id"),
+        start_payload.get("request_id"),
+        attributes.get("agentmon_model_request_id"),
+        attributes.get("request_id"),
+    ]
+    by_id = p2_index["by_id"]
+    for candidate in candidates:
+        if candidate not in {None, ""} and str(candidate) in by_id:
+            return by_id[str(candidate)]
+    return {}
+
+
+def p2_projection(row: dict[str, Any], snapshot: dict[str, Any] | None = None) -> dict[str, Any] | None:
+    if not row:
+        return None
+    prompt_tokens = integer_or_none(row.get("prompt_tokens"))
+    cached_prompt_tokens = integer_or_none(row.get("cached_prompt_tokens"))
+    recomputed_prompt_tokens = integer_or_none(row.get("recomputed_prompt_tokens"))
+    usage_before = number_or_none(row.get("kv_usage_before"))
+    usage_after = number_or_none(row.get("kv_usage_after"))
+    return {
+        "agent_request_id": row.get("agent_request_id"),
+        "vllm_request_id": row.get("vllm_request_id"),
+        "api_request_id": row.get("api_request_id"),
+        "correlation_quality": row.get("correlation_quality"),
+        "e2e_s": ns_to_s(ns_delta(row.get("received_ns"), row.get("finished_ns"))),
+        "queue_s": ns_to_s(ns_delta(row.get("queued_ns") or row.get("received_ns"), row.get("first_scheduled_ns"))),
+        "ttft_s": ns_to_s(ns_delta(row.get("received_ns"), row.get("first_token_ns"))),
+        "decode_s": ns_to_s(ns_delta(row.get("first_token_ns"), row.get("finished_ns"))),
+        "prompt_tokens": prompt_tokens,
+        "cached_prompt_tokens": cached_prompt_tokens,
+        "computed_prefill_tokens": integer_or_none(row.get("computed_prefill_tokens")),
+        "recomputed_prompt_tokens": recomputed_prompt_tokens,
+        "generation_tokens": integer_or_none(row.get("generation_tokens")),
+        "preemption_count": integer_or_none(row.get("preemption_count")),
+        "finish_reason": row.get("finish_reason"),
+        "cache_reuse_rate": ratio_or_none(cached_prompt_tokens, prompt_tokens),
+        "recomputed_prompt_rate": ratio_or_none(recomputed_prompt_tokens, prompt_tokens),
+        "kv_usage_before": usage_before,
+        "kv_usage_after": usage_after,
+        "kv_usage_delta": usage_after - usage_before if usage_before is not None and usage_after is not None else None,
+        "allocated_block_count": integer_or_none(row.get("allocated_block_count")),
+        "freed_block_count": integer_or_none(row.get("freed_block_count")),
+        "evicted_block_count": integer_or_none(row.get("evicted_block_count")),
+        "kv_quality": row.get("kv_quality"),
+        "kv_snapshot": kv_snapshot_projection(snapshot),
+    }
+
+
+def kv_snapshot_row(payload: dict[str, Any], event: dict[str, Any]) -> dict[str, Any]:
+    row = {
+        "monotonic_time_ns": integer_or_none(event.get("monotonic_time_ns")),
+        "prefix_cache_status": payload.get("prefix_cache_status"),
+        "prefix_cache_queries": integer_or_none(payload.get("prefix_cache_queries")),
+        "prefix_cache_hits": integer_or_none(payload.get("prefix_cache_hits")),
+        "kv_usage_ratio": number_or_none(payload.get("kv_usage_ratio")),
+    }
+    kv_pool = as_dict(payload.get("kv_pool"))
+    if kv_pool:
+        row["kv_pool"] = kv_pool
+    return row
+
+
+def nearest_kv_snapshot(snapshots: list[dict[str, Any]], mono_ns: int | None) -> dict[str, Any] | None:
+    if not snapshots:
+        return None
+    if mono_ns is None:
+        return snapshots[-1]
+    previous = [row for row in snapshots if isinstance(row.get("monotonic_time_ns"), int) and row["monotonic_time_ns"] <= mono_ns]
+    if previous:
+        return previous[-1]
+    return snapshots[0]
+
+
+def kv_snapshot_projection(snapshot: dict[str, Any] | None) -> dict[str, Any] | None:
+    if not snapshot:
+        return None
+    queries = integer_or_none(snapshot.get("prefix_cache_queries"))
+    hits = integer_or_none(snapshot.get("prefix_cache_hits"))
+    status = snapshot.get("prefix_cache_status")
+    kv_pool = as_dict(snapshot.get("kv_pool"))
+    return {
+        "prefix_cache_status": status,
+        "prefix_cache_queries": queries,
+        "prefix_cache_hits": hits,
+        "prefix_cache_hit_rate": None if status == "disabled" else ratio_or_none(hits, queries),
+        "kv_usage_ratio": number_or_none(snapshot.get("kv_usage_ratio")),
+        "kv_pool_allocated_bytes_per_rank": integer_or_none(kv_pool.get("allocated_pool_bytes_per_rank")),
+        "kv_pool_bytes_per_block_per_rank": integer_or_none(kv_pool.get("bytes_per_block_per_rank")),
+        "kv_pool_source_quality": kv_pool.get("source_quality"),
+    }
+
+
+def step_kv_summary(items: list[dict[str, Any]]) -> dict[str, Any]:
+    model_items = [item for item in items if item.get("item_type") == "model"]
+    p2_rows = [as_dict(item.get("p2")) for item in model_items if isinstance(item.get("p2"), dict)]
+    prompt_total = sum_present(row.get("prompt_tokens") for row in p2_rows)
+    cached_total = sum_present(row.get("cached_prompt_tokens") for row in p2_rows)
+    recomputed_total = sum_present(row.get("recomputed_prompt_tokens") for row in p2_rows)
+    snapshots = [as_dict(row.get("kv_snapshot")) for row in p2_rows if isinstance(row.get("kv_snapshot"), dict)]
+    latest_snapshot = snapshots[-1] if snapshots else None
+    kv_usage_values = [
+        number_or_none(row.get("kv_usage_after"))
+        for row in p2_rows
+        if number_or_none(row.get("kv_usage_after")) is not None
+    ]
+    return {
+        "kv_cache_prompt_tokens": prompt_total,
+        "kv_cache_cached_prompt_tokens": cached_total,
+        "kv_cache_recomputed_prompt_tokens": recomputed_total,
+        "kv_cache_reuse_rate": ratio_or_none(cached_total, prompt_total),
+        "kv_cache_recomputed_rate": ratio_or_none(recomputed_total, prompt_total),
+        "kv_usage_ratio_after_max": max(kv_usage_values) if kv_usage_values else None,
+        "kv_snapshot": latest_snapshot,
+    }
+
+
+def build_totals(steps: list[dict[str, Any]], unassigned: list[dict[str, Any]]) -> dict[str, Any]:
+    items = [item for step in steps for item in step["items"]] + unassigned
+    model_items = [item for item in items if item.get("item_type") == "model"]
+    tool_items = [item for item in items if item.get("item_type") == "tool"]
+    return {
+        "step_count": len(steps),
+        "model_request_count": len(model_items),
+        "tool_call_count": len(tool_items),
+        "model_time_s": sum(item.get("duration_s") or 0 for item in model_items),
+        "tool_time_s": sum(item.get("duration_s") or 0 for item in tool_items),
+        "prompt_tokens": sum_present(item.get("prompt_tokens") for item in model_items),
+        "completion_tokens": sum_present(item.get("completion_tokens") for item in model_items),
+        "cached_tokens": sum_present(item.get("cached_tokens") for item in model_items),
+        "kv_cache_reuse_rate_mean": mean_present(step.get("kv_cache_reuse_rate") for step in steps),
+        "kv_usage_ratio_after_max": max_present(step.get("kv_usage_ratio_after_max") for step in steps),
+        "tool_nonzero_return_count": sum(1 for item in tool_items if nonzero(item.get("returncode"))),
+        "tool_timeout_count": sum(1 for item in tool_items if item.get("timed_out") is True),
+        "unassigned_item_count": len(unassigned),
+    }
+
+
+def build_warnings(steps: list[dict[str, Any]], unassigned: list[dict[str, Any]]) -> list[str]:
+    warnings: list[str] = []
+    if not steps:
+        warnings.append("no_agent_steps_found")
+    if unassigned:
+        warnings.append("items_without_step_id")
+    model_items = [item for step in steps for item in step["items"] if item.get("item_type") == "model"]
+    if model_items and all(not item.get("p2") for item in model_items):
+        warnings.append("no_model_requests_matched_to_p2")
+    return warnings
+
+
+def build_resource_context(
+    events: list[dict[str, Any]],
+    p2_events: list[dict[str, Any]],
+    *,
+    ascend_devices: str | None,
+) -> dict[str, Any]:
+    explicit_devices = parse_device_ids(ascend_devices)
+    inferred_devices = infer_p2_visible_devices(p2_events)
+    return {
+        "proc_events": sorted(
+            [event for event in events if event.get("source") == "proc" and event.get("event_type") == "sample"],
+            key=lambda event: integer_or_none(event.get("monotonic_time_ns")) or -1,
+        ),
+        "ascend_events": sorted(
+            [event for event in events if event.get("source") == "ascend" and event.get("event_type") == "sample"],
+            key=lambda event: integer_or_none(event.get("monotonic_time_ns")) or -1,
+        ),
+        "ascend_target_devices": explicit_devices or inferred_devices,
+        "ascend_target_device_source": "cli" if explicit_devices else ("p2_visible_devices" if inferred_devices else "unavailable"),
+    }
+
+
+def proc_window_summary(
+    proc_events: list[dict[str, Any]],
+    start_ns: Any,
+    end_ns: Any,
+    *,
+    role: str | None = None,
+    pid: int | None = None,
+    pgid: int | None = None,
+) -> dict[str, Any]:
+    samples = events_in_window(proc_events, start_ns, end_ns)
+    if not samples:
+        return {"quality": "missing", "sample_count": 0}
+
+    sample_rows: list[dict[str, Any]] = []
+    by_identity: dict[tuple[int, int | None], list[dict[str, Any]]] = {}
+    clk_tck = None
+    for event in samples:
+        payload = as_dict(event.get("payload"))
+        aggregate = as_dict(payload.get("aggregate"))
+        clk_tck = integer_or_none(aggregate.get("clk_tck")) or clk_tck
+        processes = []
+        for process in payload.get("processes") or []:
+            if not isinstance(process, dict) or not proc_process_matches(process, role=role, pid=pid, pgid=pgid):
+                continue
+            processes.append(process)
+            proc_pid = integer_or_none(process.get("pid"))
+            if proc_pid is not None:
+                identity = (proc_pid, integer_or_none(process.get("starttime_ticks")))
+                process_row = dict(process)
+                process_row["_sample_mono_ns"] = integer_or_none(event.get("monotonic_time_ns"))
+                by_identity.setdefault(identity, []).append(process_row)
+
+        rss = sum_numeric(process.get("rss_bytes") for process in processes)
+        pss = sum_numeric(process.get("pss_bytes") for process in processes)
+        private_bytes = sum_numeric(process.get("private_bytes") for process in processes)
+        sample_rows.append(
+            {
+                "monotonic_time_ns": integer_or_none(event.get("monotonic_time_ns")),
+                "process_count": len(processes),
+                "rss_bytes": rss,
+                "pss_bytes": pss,
+                "private_bytes": private_bytes,
+            }
+        )
+
+    clk = clk_tck or 100
+    cpu_ticks = 0
+    read_delta = 0
+    write_delta = 0
+    read_found = False
+    write_found = False
+    for rows in by_identity.values():
+        rows.sort(key=lambda row: integer_or_none(row.get("_sample_mono_ns")) or -1)
+        first = rows[0]
+        last = rows[-1]
+        cpu_ticks += max(
+            0,
+            (integer_or_none(last.get("utime_ticks")) or 0)
+            + (integer_or_none(last.get("stime_ticks")) or 0)
+            - (integer_or_none(first.get("utime_ticks")) or 0)
+            - (integer_or_none(first.get("stime_ticks")) or 0),
+        )
+        read_start = integer_or_none(first.get("read_bytes"))
+        read_end = integer_or_none(last.get("read_bytes"))
+        if read_start is not None and read_end is not None:
+            read_delta += max(0, read_end - read_start)
+            read_found = True
+        write_start = integer_or_none(first.get("write_bytes"))
+        write_end = integer_or_none(last.get("write_bytes"))
+        if write_start is not None and write_end is not None:
+            write_delta += max(0, write_end - write_start)
+            write_found = True
+
+    cpu_time_s = cpu_ticks / clk if clk > 0 else None
+    window_s = window_duration_s(start_ns, end_ns, samples)
+    cpu_wall_ratio = ratio_or_none(cpu_time_s, window_s)
+    process_count_max = max_present(row.get("process_count") for row in sample_rows)
+    process_count_last = sample_rows[-1].get("process_count") if sample_rows else None
+    return {
+        "quality": "sampled_window" if len(samples) >= 2 else "single_sample",
+        "sample_count": len(samples),
+        "process_count_max": integer_or_none(process_count_max),
+        "process_count_last": process_count_last,
+        "cpu_time_s": cpu_time_s,
+        "cpu_wall_ratio": cpu_wall_ratio,
+        "avg_cpu_percent": cpu_wall_ratio * 100 if cpu_wall_ratio is not None else None,
+        "peak_rss_bytes": max_present(row.get("rss_bytes") for row in sample_rows),
+        "avg_rss_bytes": mean_present(row.get("rss_bytes") for row in sample_rows),
+        "peak_pss_bytes": max_present(row.get("pss_bytes") for row in sample_rows),
+        "avg_pss_bytes": mean_present(row.get("pss_bytes") for row in sample_rows),
+        "peak_private_bytes": max_present(row.get("private_bytes") for row in sample_rows),
+        "avg_private_bytes": mean_present(row.get("private_bytes") for row in sample_rows),
+        "read_bytes_delta": read_delta if read_found else None,
+        "write_bytes_delta": write_delta if write_found else None,
+    }
+
+
+def ascend_window_summary(
+    ascend_events: list[dict[str, Any]],
+    start_ns: Any,
+    end_ns: Any,
+    *,
+    target_devices: set[str] | None,
+) -> dict[str, Any]:
+    samples = events_in_window(ascend_events, start_ns, end_ns)
+    if not samples:
+        return {"quality": "missing", "sample_count": 0, "target_attribution_status": "unavailable"}
+
+    host_rows: list[dict[str, Any]] = []
+    target_rows: list[dict[str, Any]] = []
+    parser_confidences: list[float] = []
+    collected_devices: set[str] = set()
+    for event in samples:
+        payload = as_dict(event.get("payload"))
+        confidence = number_or_none(payload.get("parser_confidence"))
+        if confidence is not None:
+            parser_confidences.append(float(confidence))
+        devices = [device for device in payload.get("devices") or [] if isinstance(device, dict)]
+        for device in devices:
+            device_id = device_identity(device)
+            if device_id is not None:
+                collected_devices.add(device_id)
+        host_rows.append(device_sample_summary(devices))
+        selected = [device for device in devices if target_devices and device_identity(device) in target_devices]
+        target_rows.append(device_sample_summary(selected))
+
+    has_target = bool(target_devices)
+    target_has_metrics = any(row.get("hbm_used_bytes") is not None or row.get("aicore_util_pct") is not None for row in target_rows)
+    return {
+        "quality": "sampled_window" if len(samples) >= 2 else "single_sample",
+        "sample_count": len(samples),
+        "parser_confidence_mean": sum(parser_confidences) / len(parser_confidences) if parser_confidences else None,
+        "collected_devices": sorted(collected_devices),
+        "target_devices": sorted(target_devices) if target_devices else None,
+        "target_attribution_status": "complete" if has_target and target_has_metrics else "unavailable",
+        "target_peak_hbm_used_bytes": max_present(row.get("hbm_used_bytes") for row in target_rows) if has_target else None,
+        "target_avg_hbm_used_bytes": mean_present(row.get("hbm_used_bytes") for row in target_rows) if has_target else None,
+        "target_max_aicore_util_pct": max_present(row.get("aicore_util_pct") for row in target_rows) if has_target else None,
+        "target_avg_aicore_util_pct": mean_present(row.get("aicore_util_pct") for row in target_rows) if has_target else None,
+        "host_peak_hbm_used_bytes": max_present(row.get("hbm_used_bytes") for row in host_rows),
+        "host_avg_hbm_used_bytes": mean_present(row.get("hbm_used_bytes") for row in host_rows),
+        "host_max_aicore_util_pct": max_present(row.get("aicore_util_pct") for row in host_rows),
+        "host_avg_aicore_util_pct": mean_present(row.get("aicore_util_pct") for row in host_rows),
+    }
+
+
+def events_in_window(events: list[dict[str, Any]], start_ns: Any, end_ns: Any) -> list[dict[str, Any]]:
+    start = integer_or_none(start_ns)
+    end = integer_or_none(end_ns)
+    selected: list[dict[str, Any]] = []
+    for event in events:
+        mono = integer_or_none(event.get("monotonic_time_ns"))
+        if mono is None:
+            continue
+        if start is not None and mono < start:
+            continue
+        if end is not None and mono > end:
+            continue
+        selected.append(event)
+    return selected
+
+
+def proc_process_matches(
+    process: dict[str, Any],
+    *,
+    role: str | None,
+    pid: int | None,
+    pgid: int | None,
+) -> bool:
+    if pid is not None and integer_or_none(process.get("pid")) == pid:
+        return True
+    if pgid is not None and integer_or_none(process.get("pgid")) == pgid:
+        return True
+    if pid is not None or pgid is not None:
+        return False
+    return role is None or process.get("role") == role
+
+
+def device_sample_summary(devices: list[dict[str, Any]]) -> dict[str, Any]:
+    hbm_values = [number_or_none(device.get("hbm_used_bytes")) for device in devices]
+    hbm_clean = [value for value in hbm_values if value is not None]
+    util_values = [number_or_none(device.get("aicore_util_pct")) for device in devices]
+    util_clean = [value for value in util_values if value is not None]
+    return {
+        "hbm_used_bytes": sum(hbm_clean) if hbm_clean else None,
+        "aicore_util_pct": max(util_clean) if util_clean else None,
+    }
+
+
+def device_identity(device: dict[str, Any]) -> str | None:
+    for key in ("device_id", "npu_id", "id", "chip_id"):
+        value = device.get(key)
+        if value not in {None, ""}:
+            return str(value)
+    return None
+
+
+def parse_device_ids(value: str | None) -> set[str] | None:
+    if not value:
+        return None
+    devices = {part.strip() for part in value.split(",") if part.strip()}
+    return devices or None
+
+
+def infer_p2_visible_devices(events: list[dict[str, Any]]) -> set[str] | None:
+    for event in events:
+        if event.get("source") != "vllm_p2" or event.get("event_type") != "vllm.adapter.capability":
+            continue
+        payload = as_dict(event.get("payload"))
+        for key in ("visible_devices", "target_devices", "device_ids", "ascend_devices"):
+            devices = normalize_device_list(payload.get(key))
+            if devices:
+                return devices
+    return None
+
+
+def normalize_device_list(value: Any) -> set[str] | None:
+    if isinstance(value, str):
+        return parse_device_ids(value)
+    if isinstance(value, (list, tuple)):
+        devices = {str(item) for item in value if item not in {None, ""}}
+        return devices or None
+    return None
+
+
+def window_duration_s(start_ns: Any, end_ns: Any, events: list[dict[str, Any]]) -> float | None:
+    explicit = ns_to_s(ns_delta(start_ns, end_ns))
+    if explicit is not None and explicit > 0:
+        return explicit
+    times = [integer_or_none(event.get("monotonic_time_ns")) for event in events]
+    clean = [time_ns for time_ns in times if time_ns is not None]
+    if len(clean) >= 2:
+        return ns_to_s(max(clean) - min(clean))
+    return None
+
+
+def format_output(payload: dict[str, Any] | list[dict[str, Any]], fmt: str) -> str:
+    if fmt == "json":
+        return json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True)
+    analyses = payload if isinstance(payload, list) else [payload]
+    if fmt == "csv":
+        return format_csv(analyses)
+    return "\n\n".join(format_table_one(analysis) for analysis in analyses)
+
+
+def format_table_one(analysis: dict[str, Any]) -> str:
+    totals = analysis["totals"]
+    lines = [
+        f"Run {analysis['run_id']} | steps={totals['step_count']} "
+        f"models={totals['model_request_count']} tools={totals['tool_call_count']} "
+        f"model_time={fmt_s(totals['model_time_s'])} tool_time={fmt_s(totals['tool_time_s'])}",
+    ]
+    for step in analysis["steps"]:
+        snapshot = as_dict(step.get("kv_snapshot"))
+        agent_proc = as_dict(step.get("agent_proc"))
+        vllm_proc = as_dict(step.get("vllm_proc"))
+        npu = as_dict(step.get("npu"))
+        lines.append(
+            f"Step {step['step_index']:>2} {step['step_id']} "
+            f"status={step.get('status') or 'N/A'} duration={fmt_s(step.get('duration_s'))} "
+            f"model={fmt_s(step.get('model_time_s'))} tool={fmt_s(step.get('tool_time_s'))} "
+            f"agent_cpu={fmt_s(agent_proc.get('cpu_time_s'))} "
+            f"agent_cpu/wall={fmt_pct(agent_proc.get('cpu_wall_ratio'))} "
+            f"agent_pss={fmt_bytes(agent_proc.get('peak_pss_bytes'))} "
+            f"vllm_cpu={fmt_s(vllm_proc.get('cpu_time_s'))} "
+            f"hbm={fmt_bytes(first_value(npu.get('target_peak_hbm_used_bytes'), npu.get('host_peak_hbm_used_bytes')))} "
+            f"aicore={fmt_pct_value(first_value(npu.get('target_max_aicore_util_pct'), npu.get('host_max_aicore_util_pct')))} "
+            f"reuse={fmt_pct(step.get('kv_cache_reuse_rate'))} "
+            f"kv_usage={fmt_pct(first_value(step.get('kv_usage_ratio_after_max'), snapshot.get('kv_usage_ratio')))} "
+            f"pool/rank={fmt_bytes(snapshot.get('kv_pool_allocated_bytes_per_rank'))}"
+        )
+        for item in step["items"]:
+            if item["item_type"] == "model":
+                p2 = item.get("p2") or {}
+                kv_snapshot = as_dict(p2.get("kv_snapshot"))
+                vllm_proc = as_dict(item.get("vllm_proc"))
+                npu = as_dict(item.get("npu"))
+                lines.append(
+                    "  "
+                    f"{item['item_index']:>2}. model duration={fmt_s(item.get('duration_s'))} "
+                    f"p2_e2e={fmt_s(p2.get('e2e_s'))} "
+                    f"vllm_cpu={fmt_s(vllm_proc.get('cpu_time_s'))} "
+                    f"hbm={fmt_bytes(first_value(npu.get('target_peak_hbm_used_bytes'), npu.get('host_peak_hbm_used_bytes')))} "
+                    f"tokens={fmt_na(item.get('prompt_tokens'))}/{fmt_na(item.get('completion_tokens'))} "
+                    f"cached={fmt_na(item.get('cached_tokens'))} "
+                    f"reuse={fmt_pct(p2.get('cache_reuse_rate'))} "
+                    f"kv={fmt_pct(first_value(p2.get('kv_usage_after'), kv_snapshot.get('kv_usage_ratio')))} "
+                    f"corr={p2.get('correlation_quality') or 'N/A'}"
+                )
+            else:
+                output_bytes = first_value(item.get("output_bytes"), item.get("stdout_bytes"))
+                proc = as_dict(item.get("proc"))
+                lines.append(
+                    "  "
+                    f"{item['item_index']:>2}. tool {item.get('tool_name') or item.get('executable') or 'N/A'} "
+                    f"duration={fmt_s(item.get('duration_s'))} cpu={fmt_s(proc.get('cpu_time_s'))} "
+                    f"pss={fmt_bytes(proc.get('peak_pss_bytes'))} rc={fmt_na(item.get('returncode'))} "
+                    f"timeout={item.get('timed_out') is True} output_bytes={fmt_na(output_bytes)}"
+                )
+    if analysis.get("unassigned_items"):
+        lines.append(f"Unassigned items: {len(analysis['unassigned_items'])}")
+    if analysis.get("warnings"):
+        lines.append("Warnings: " + ", ".join(analysis["warnings"]))
+    return "\n".join(lines)
+
