+                {"span_type": "model_request", "status": "success", "duration_s": 0.3},
+                {"span_type": "tool_call", "status": "success", "duration_s": 1.0},
+                {"span_type": "tool_call", "status": "failed", "duration_s": 2.0},
+            ],
+        },
+        "tool_attribution": {
+            "tool_calls": 2,
