+        "kv_cache": {
+            "prefix_cache_status": prefix_status,
+            "prefix_cache_hit_rate": prefix_hit_rate,
+            "prefix_cache_hit_rate_quality": "sampled" if prefix_status == "enabled" else "disabled",
+            "kv_cache_usage_ratio_max": kv,
