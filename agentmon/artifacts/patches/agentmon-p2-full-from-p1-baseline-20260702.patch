+        ),
+        "ttft": p2_latency_stats(
+            [ns_delta_s(row.get("received_ns"), row.get("first_token_ns")) for row in rows]
+        ),
+        "e2e": p2_latency_stats(
+            [ns_delta_s(row.get("received_ns"), row.get("finished_ns")) for row in rows]
