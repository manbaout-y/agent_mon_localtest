+def detect_trajectory_output_paths(argv: Sequence[str]) -> list[Path]:
+    paths: list[Path] = []
+    index = 0
+    while index < len(argv):
+        item = argv[index]
+        if item in {"-o", "--output"} and index + 1 < len(argv):
+            paths.append(Path(argv[index + 1]))
+            index += 2
+            continue
