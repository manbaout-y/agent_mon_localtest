+def usage_from_message(message: dict[str, Any]) -> dict[str, Any] | None:
+    extra = message.get("extra")
+    candidates: list[Any] = []
+    if isinstance(extra, dict):
+        candidates.append(extra.get("usage"))
+        response = extra.get("response")
+        if isinstance(response, dict):
