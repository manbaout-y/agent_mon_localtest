+                    writer.write_event(event)
+        report = write_reports(run_dir)
+    except Exception as exc:
+        print(f"agentmon import-p2 error: {exc}", file=sys.stderr)
+        return 2
+
+    result = {
+        "schema_version": "1.0",
+        "command": "import-p2",
+        "run_id": args.run_id,
