+def write_events(path: Path, events: list[dict]) -> None:
+    path.write_text("\n".join(json.dumps(event) for event in events) + "\n", encoding="utf-8")
+
+
+def event(event_type: str, *, source: str = "mini_swe", payload: dict | None = None, mono: int = 0) -> dict:
+    return {
+        "schema_version": "1.0",
+        "event_id": f"{event_type}-{mono}",
+        "run_id": "run-seq",
+        "source": source,
+        "event_type": event_type,
+        "quality": "exact",
+        "wall_time_ns": mono,
+        "monotonic_time_ns": mono,
+        "labels": {},
+        "payload": payload or {},
+    }
+
+
+def ns(seconds: float) -> int:
+    return int(seconds * 1_000_000_000)
+
+
+def sequence_events() -> list[dict]:
+    return [
+        event(
+            "agent_step.start",
+            mono=ns(0.0),
+            payload={"span_id": "step-1", "span_type": "agent_step", "start_mono_ns": ns(0.0)},
+        ),
+        event(
+            "model_request.start",
+            mono=ns(0.1),
+            payload={
+                "span_id": "model-1",
+                "span_type": "model_request",
+                "step_id": "step-1",
+                "parent_span_id": "step-1",
+                "start_mono_ns": ns(0.1),
+                "model_name": "qwen",
+                "agentmon_model_request_id": "model-1",
+                "request_id": "model-1",
+            },
+        ),
+        event(
+            "vllm.adapter.capability",
+            source="vllm_p2",
+            mono=ns(0.12),
+            payload={"visible_devices": ["0", "1"]},
+        ),
+        event(
+            "vllm.kv.snapshot",
+            source="vllm_p2",
+            mono=ns(0.15),
+            payload={
+                "prefix_cache_status": "enabled",
+                "prefix_cache_queries": 4,
+                "prefix_cache_hits": 2,
+                "kv_usage_ratio": 0.20,
+                "kv_pool": {
+                    "allocated_pool_bytes_per_rank": 4096,
+                    "bytes_per_block_per_rank": 512,
+                    "source_quality": "complete",
+                },
+            },
+        ),
+        event(
+            "vllm.request.received",
+            source="vllm_p2",
+            mono=ns(0.2),
+            payload={
+                "agent_request_id": "model-1",
+                "vllm_request_id": "vllm-1",
+                "correlation_quality": "direct",
+                "received_ns": ns(0.2),
+            },
+        ),
+        proc_event(
+            ns(0.2),
+            [
+                proc_sample(pid=100, role="agent", starttime=10, utime=10, stime=5, rss=1000, pss=900),
+                proc_sample(pid=200, role="vllm", starttime=20, utime=100, stime=50, rss=10000, pss=9000),
+            ],
+        ),
+        ascend_event(
+            ns(0.2),
+            [
+                {"device_id": "0", "hbm_used_bytes": 1000, "aicore_util_pct": 10},
+                {"device_id": "1", "hbm_used_bytes": 2000, "aicore_util_pct": 20},
+            ],
+        ),
+        event(
+            "vllm.request.first_token",
+            source="vllm_p2",
+            mono=ns(1.0),
+            payload={
+                "agent_request_id": "model-1",
+                "vllm_request_id": "vllm-1",
+                "correlation_quality": "direct",
+                "first_token_ns": ns(1.0),
+            },
+        ),
+        proc_event(
+            ns(2.6),
+            [
+                proc_sample(pid=100, role="agent", starttime=10, utime=15, stime=6, rss=1200, pss=1000),
+                proc_sample(pid=200, role="vllm", starttime=20, utime=120, stime=60, rss=12000, pss=10000),
+            ],
+        ),
+        ascend_event(
+            ns(2.6),
+            [
+                {"device_id": "0", "hbm_used_bytes": 3000, "aicore_util_pct": 50},
+                {"device_id": "1", "hbm_used_bytes": 4000, "aicore_util_pct": 60},
+            ],
+        ),
+        event(
+            "vllm.kv.block_event",
+            source="vllm_p2",
+            mono=ns(2.0),
+            payload={
+                "request_id": "vllm-1",
+                "vllm_request_id": "vllm-1",
+                "allocated_block_count": 8,
+                "freed_block_count": 7,
+                "evicted_block_count": 1,
+                "kv_usage_before": 0.20,
+                "kv_usage_after": 0.25,
+                "kv_quality": "exact",
+            },
+        ),
+        event(
+            "vllm.request.finished",
+            source="vllm_p2",
+            mono=ns(2.7),
+            payload={
+                "agent_request_id": "model-1",
+                "vllm_request_id": "vllm-1",
+                "correlation_quality": "direct",
+                "finished_ns": ns(2.7),
+                "prompt_tokens": 10,
+                "cached_prompt_tokens": 2,
+                "recomputed_prompt_tokens": 1,
+                "generation_tokens": 3,
+            },
+        ),
+        event(
+            "model_request.end",
+            mono=ns(2.8),
+            payload={
+                "span_id": "model-1",
+                "span_type": "model_request",
+                "step_id": "step-1",
+                "parent_span_id": "step-1",
+                "end_mono_ns": ns(2.8),
+                "duration_ns": ns(2.7),
+                "status": "success",
+                "usage": {"prompt_tokens": 10, "completion_tokens": 3, "cached_tokens": 1},
+            },
+        ),
+        event(
+            "tool_call.start",
+            mono=ns(3.0),
+            payload={
+                "span_id": "tool-1",
+                "tool_call_id": "tool-1",
+                "span_type": "tool_call",
+                "step_id": "step-1",
+                "parent_span_id": "step-1",
+                "start_mono_ns": ns(3.0),
+                "tool_name": "bash",
+                "executable": "bash",
+                "command_hash": "abc",
+            },
+        ),
+        proc_event(
+            ns(3.05),
+            [
+                proc_sample(pid=100, role="agent", starttime=10, utime=20, stime=8, rss=1300, pss=1100),
+                proc_sample(pid=300, role="agent", starttime=30, utime=0, stime=0, rss=400, pss=300, pgid=3000),
+            ],
+        ),
+        event(
+            "tool_call.end",
+            mono=ns(3.4),
+            payload={
+                "span_id": "tool-1",
+                "tool_call_id": "tool-1",
+                "span_type": "tool_call",
+                "step_id": "step-1",
+                "parent_span_id": "step-1",
+                "end_mono_ns": ns(3.4),
+                "duration_ns": ns(0.4),
+                "status": "failed",
+                "returncode": 1,
+                "pid": 300,
+                "pgid": 3000,
+                "output_bytes": 12,
+                "attribution_quality": "exact_pid_boundary",
+            },
+        ),
+        proc_event(
+            ns(3.35),
+            [
+                proc_sample(pid=100, role="agent", starttime=10, utime=30, stime=10, rss=1400, pss=1200),
+                proc_sample(pid=300, role="agent", starttime=30, utime=20, stime=0, rss=600, pss=500, pgid=3000),
+            ],
+        ),
+        event(
+            "agent_step.end",
+            mono=ns(3.5),
+            payload={
+                "span_id": "step-1",
+                "span_type": "agent_step",
+                "end_mono_ns": ns(3.5),
+                "duration_ns": ns(3.5),
+                "status": "success",
+            },
+        ),
+    ]
